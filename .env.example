# =============================================================================
# YatraAI - environment variable names only. NEVER commit real values.
# Copy to `.env` and fill in. `.env` is git-ignored.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
YATRA_ENV=development                 # development | test | production
YATRA_LOG_LEVEL=INFO
YATRA_LOG_JSON=false                  # true in production
YATRA_API_HOST=0.0.0.0
YATRA_API_PORT=8000

# ---- Database ---------------------------------------------------------------
# PostgreSQL 16 + pgvector. Docker Compose provides this automatically.
# Leave blank to fall back to a local SQLite file (demo/offline mode).
DATABASE_URL=postgresql+psycopg://yatra:yatra@localhost:5432/yatraai
SQLITE_FALLBACK_PATH=./yatraai.sqlite3

# ---- Auth -------------------------------------------------------------------
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=120
# Supabase (optional). When set, Supabase-issued JWTs are accepted as well.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=            # server-side only, never expose to web

# ---- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- LLM provider abstraction ----------------------------------------------
# One of: mock | anthropic | gemini   ("mock" needs no key and is fully offline)
LLM_PROVIDER=mock
LLM_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1200

# ---- Embeddings -------------------------------------------------------------
# One of: hashing | sentence-transformers
# "hashing" is deterministic, dependency-free and used when torch is absent.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---- Weather provider -------------------------------------------------------
# One of: open-meteo | seed   ("seed" replays committed climatology, offline)
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_TTL_SECONDS=3600

# ---- Routing provider -------------------------------------------------------
# One of: osrm | haversine   (haversine is the documented offline fallback)
ROUTING_PROVIDER=haversine
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=8

# ---- Optimizer --------------------------------------------------------------
ORTOOLS_TIME_LIMIT_SECONDS=10
PLANNER_RANDOM_SEED=20240101

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_AI_PER_MINUTE=15
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# ---- Location privacy -------------------------------------------------------
LOCATION_POINT_RETENTION_MINUTES=120
LOCATION_SESSION_MAX_HOURS=12

# ---- Ingestion allow-list (comma separated domains) -------------------------
# Suffix matched: "gov.in" admits "asi.gov.in", "megtourism.gov.in", etc.
INGEST_ALLOWED_DOMAINS=gov.in,nic.in,ac.in,unesco.org,karnatakatourism.org,salarjungmuseum.in,hal-india.co.in,taralaya.org,shrikashivishwanath.org,shreejagannatha.in,bahaihouseofworship.in,openstreetmap.org,wikipedia.org,wikidata.org

# ---- Frontend (apps/web/.env.local) ----------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
